<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rubaya 🌙👀</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Great+Vibes&family=Cormorant+Garamond:ital,wght@1,600&display=swap');

*{
  box-sizing:border-box;
}

html,body{
  margin:0;
  width:100%;
  height:100%;
  overflow:hidden;
}

body{
  background:#010006;
  color:white;
}

canvas{
  position:fixed;
  inset:0;
  width:100%;
  height:100%;
  touch-action:none;
}

/* Main text */
.title{
  position:fixed;
  z-index:3;
  top:6vh;
  width:100%;
  text-align:center;
  padding:0 10px;
  pointer-events:none;

  font-family:'Cormorant Garamond',Georgia,serif;
  font-style:italic;
  font-weight:600;
  font-size:clamp(24px,6vw,40px);
  line-height:1.1;
  letter-spacing:1px;

  text-shadow:
    0 0 8px #fff,
    0 0 18px #ff55b6,
    0 0 35px #9c35ff;
}

/* Rubaya fancy font */
.name{
  margin-top:8px;

  font-family:'Great Vibes','Brush Script MT',cursive;
  font-size:clamp(60px,16vw,92px);
  font-weight:400;
  letter-spacing:2px;

  color:#ffd9f1;

  text-shadow:
    0 0 5px #fff,
    0 0 14px #ff3da9,
    0 0 32px #d02cff,
    0 0 60px #8b2cff;
}

/* Music button */
#play{
  position:fixed;
  z-index:5;
  left:50%;
  top:39%;
  transform:translate(-50%,-50%);

  border:1px solid rgba(255,255,255,.5);
  border-radius:30px;
  padding:11px 22px;

  background:rgba(255,30,150,.16);
  color:white;
  font-size:15px;

  box-shadow:0 0 25px #ff2c9a;
  backdrop-filter:blur(8px);
}

#play.hide{
  display:none;
}

.hint{
  position:fixed;
  z-index:3;
  bottom:4vh;
  width:100%;
  text-align:center;

  font:italic 14px Georgia,serif;
  letter-spacing:2px;

  color:#ffc7e6;
  text-shadow:0 0 12px #ff3ca5;
}
</style>
</head>

<body>

<canvas id="c"></canvas>

<div class="title">
  Happy 8 Months Anniversary 🌙👀
  <div class="name">Rubaya 🫀🫂</div>
</div>

<button id="play">▶ Play Reha</button>

<div class="hint">
  touch the heart 🩷
</div>

<audio id="song" preload="auto" playsinline></audio>

<script>

const c = document.getElementById("c");
const ctx = c.getContext("2d");

const song = document.getElementById("song");
const btn = document.getElementById("play");

/*
  IMPORTANT:
  GitHub Pages cannot access the MP3 from your phone.
  So upload your MP3 to the same GitHub repository,
  rename it to:

  reha.mp3

  Then this line will play it.
*/
song.src = "reha.mp3";

let W,H;
let dots=[];
let stars=[];

let touch={
  x:0,
  y:0,
  on:false
};


/* Heart shape */
function heart(t){

  return {
    x:
      16 * Math.sin(t) ** 3,

    y:
      -(
        13 * Math.cos(t)
        - 5 * Math.cos(2*t)
        - 2 * Math.cos(3*t)
        - Math.cos(4*t)
      )
  };

}


/* Resize */
function resize(){

  W = innerWidth;
  H = innerHeight;

  const d = Math.min(devicePixelRatio || 1,1.3);

  c.width = W*d;
  c.height = H*d;

  ctx.setTransform(d,0,0,d,0,0);

  stars=[];
  dots=[];


  /* Stars */

  for(let i=0;i<180;i++){

    stars.push({
      x:Math.random()*W,
      y:Math.random()*H,
      r:.25+Math.random()*.9,
      a:.3+Math.random()*.7
    });

  }


  /* Particle heart */

  const scale = Math.min(W,H)*.0175;

  const cx = W/2;
  const cy = H*.59;


  for(let i=0;i<900;i++){

    const q = heart(Math.random()*Math.PI*2);

    const k = Math.sqrt(Math.random());

    const ox =
      cx + q.x*scale*k;

    const oy =
      cy + q.y*scale*k;


    dots.push({

      x:ox,
      y:oy,

      ox:ox,
      oy:oy,

      vx:0,
      vy:0,

      r:.45+Math.random()*.7

    });

  }

}


/* Animation */

function animate(){

  /* Galaxy background */

  const g =
    ctx.createRadialGradient(
      W*.5,
      H*.55,
      0,
      W*.5,
      H*.55,
      Math.max(W,H)*.8
    );

  g.addColorStop(0,"#290022");
  g.addColorStop(.45,"#0b0015");
  g.addColorStop(1,"#010004");

  ctx.fillStyle=g;
  ctx.fillRect(0,0,W,H);


  /* Stars */

  for(const s of stars){

    ctx.globalAlpha=s.a;

    ctx.fillStyle="#ffe0f4";

    ctx.beginPath();

    ctx.arc(
      s.x,
      s.y,
      s.r,
      0,
      Math.PI*2
    );

    ctx.fill();

  }

  ctx.globalAlpha=1;


  /* Heart particles */

  for(const d of dots){

    /* Push particles away from finger */

    if(touch.on){

      const dx=d.x-touch.x;
      const dy=d.y-touch.y;

      const dist=Math.hypot(dx,dy);

      const radius=105;


      if(dist<radius){

        const force =
          (1-dist/radius)**2;


        d.vx +=
          (dx/(dist||1))*force*3;

        d.vy +=
          (dy/(dist||1))*force*3;

      }

    }


    /* Smooth return */

    d.vx +=
      (d.ox-d.x)*.055;

    d.vy +=
      (d.oy-d.y)*.055;


    d.vx*=.82;
    d.vy*=.82;


    d.x+=d.vx;
    d.y+=d.vy;


    /* Draw */

    ctx.beginPath();

    ctx.arc(
      d.x,
      d.y,
      d.r,
      0,
      Math.PI*2
    );

    ctx.fillStyle=
      "rgba(255,72,175,.9)";

    ctx.shadowBlur=7;
    ctx.shadowColor="#ff1493";

    ctx.fill();

  }


  ctx.shadowBlur=0;

  requestAnimationFrame(animate);

}


/* Touch interaction */

function touchHeart(e){

  const r =
    c.getBoundingClientRect();

  touch.x =
    e.clientX-r.left;

  touch.y =
    e.clientY-r.top;

  touch.on=true;


  /* Start music after user interaction */

  if(song.paused){

    song.play()
      .then(()=>{
        btn.classList.add("hide");
      })
      .catch(()=>{});

  }

}


c.addEventListener(
  "pointerdown",
  touchHeart
);

c.addEventListener(
  "pointermove",
  e=>{
    if(touch.on){
      touchHeart(e);
    }
  }
);

["pointerup","pointercancel","pointerleave"]
.forEach(type=>{

  c.addEventListener(
    type,
    ()=>{
      touch.on=false;
    }
  );

});


/* Music button */

btn.onclick=()=>{

  song.play()
    .then(()=>{
      btn.classList.add("hide");
    })
    .catch(()=>{
      btn.textContent=
        "▶ Tap again to play";
    });

};


addEventListener(
  "resize",
  resize
);


resize();
animate();

</script>

</body>
</html>
